# The web image is built from this directory. Nothing below is needed to build it, and some of it must never
# reach an image layer: `next build` copies .env and .env.production into the standalone server it ships.
# Environment files (secrets, reviewer tokens). The example holds no values.
.env*
!.env.example
# Dependencies and build output: installed and rebuilt inside the image.
node_modules
.next
.next-*
out
*.tsbuildinfo
next-env.d.ts
# Browser tests and their output.
e2e
test-results
playwright-report
blob-report
# Local state, tooling and repository metadata.
var
coverage
*.log
.DS_Store
.git
.claude
AGENTS.md
Dockerfile
.dockerignore
