{
  // The browser tests are excluded from the application's tsconfig (they are not part of the Next.js build), so
  // they are type-checked here: `npm run typecheck` runs `tsc -p e2e` after the application check.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["./**/*.ts", "../playwright.config.ts", "../playwright.capture.config.ts"],
  "exclude": []
}
