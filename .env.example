# IncretinOS configuration — every value is optional; the defaults run fully offline.

# Database. Default: SQLite file under backend/var. Docker Compose sets PostgreSQL.
# INCRETINOS_DATABASE_URL=postgresql+psycopg://incretinos:incretinos@localhost:5432/incretinos

# true  = serve every external request from committed fixtures (no network)
# false = query ClinicalTrials.gov, PubMed and openFDA live
INCRETINOS_OFFLINE=true

# Optional keys that only raise public-API rate limits. Never required.
# INCRETINOS_NCBI_API_KEY=
# INCRETINOS_NCBI_EMAIL=
# INCRETINOS_OPENFDA_API_KEY=

# Reviewer token for recording review decisions. Leave unset for a read-only deployment.
# INCRETINOS_REVIEWER_TOKEN=change-me

# Scheduled live re-ingestion, in hours (0 = disabled; ignored when offline).
# INCRETINOS_REFRESH_HOURS=24

# Optional language-model summary layer. "none" keeps the assistant fully deterministic.
INCRETINOS_LLM_PROVIDER=none
# INCRETINOS_LLM_PROVIDER=anthropic
# INCRETINOS_LLM_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=            # read by the Anthropic SDK; or set INCRETINOS_ANTHROPIC_API_KEY
