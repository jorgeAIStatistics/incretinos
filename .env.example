# IncretinOS configuration — every value is optional; the defaults run fully offline and read-only.
#
# Copy this file to .env IN THIS DIRECTORY (the repository root). It is then read by:
#   - Docker Compose, for the ${VARIABLES} in docker-compose.yml;
#   - the backend (CLI and API), whatever directory it is started from. backend/.env is read as well and wins.
# The backend never looks for a .env in the current working directory. To use a file somewhere else, set
# INCRETINOS_ENV_FILE=/path/to/file (or INCRETINOS_ENV_FILE=none to read no file). Real environment variables
# always override the file, and every command prints which file it read.

# --- Database ---------------------------------------------------------------------------------------------
# Default: a SQLite file under backend/var. Docker Compose sets PostgreSQL itself.
# INCRETINOS_DATABASE_URL=postgresql+psycopg://incretinos:CHANGE-ME@localhost:5432/incretinos

# --- Data sources -----------------------------------------------------------------------------------------
# true  = serve every external request from committed fixtures (no network)
# false = query ClinicalTrials.gov, PubMed and openFDA live
INCRETINOS_OFFLINE=true

# Optional keys that only raise public-API rate limits. Never required.
# INCRETINOS_NCBI_API_KEY=
# INCRETINOS_NCBI_EMAIL=
# INCRETINOS_OPENFDA_API_KEY=

# Scheduled live re-ingestion, in hours (0 = disabled; ignored when offline).
# INCRETINOS_REFRESH_HOURS=24

# --- Review -----------------------------------------------------------------------------------------------
# Reviewer token for recording review decisions. Leave unset for a read-only deployment: without it no HTTP
# request can change the database. Use a long random value, never a word:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# The token is sent in a request header, so a shared deployment needs TLS in front of it.
# INCRETINOS_REVIEWER_TOKEN=
# The shared token above is a DEVELOPMENT mode: whoever holds it types a reviewer name, and every decision is
# labelled "self-declared under the shared token".
#
# Per-reviewer credentials (use these for real review). A JSON file mapping each reviewer's name to the sha256
# hex digest of that reviewer's own token, for example
#   {"Dr. Jane Doe": "<sha256 hex>", "Dr. John Roe": "<sha256 hex>"}
# Create a token and its digest with:
#   python3 -c "import hashlib, secrets; t = secrets.token_urlsafe(32); print('token :', t); print('sha256:', hashlib.sha256(t.encode()).hexdigest())"
# Give each reviewer only their token; put only the digest in the file. When this is set, only these tokens can
# write, the shared token above is not accepted, and the reviewer name of every decision is the one bound to the
# token (a different name sent by the client is refused). Decisions are labelled "authenticated reviewer".
# INCRETINOS_REVIEWERS_FILE=/path/to/reviewers.json

# --- Assistant --------------------------------------------------------------------------------------------
# Optional language-model summary layer. "none" keeps the assistant fully deterministic.
INCRETINOS_LLM_PROVIDER=none
# INCRETINOS_LLM_PROVIDER=anthropic
# INCRETINOS_LLM_MODEL=claude-opus-5-5
# INCRETINOS_ANTHROPIC_API_KEY=
# (This file is not exported to the process environment, so a bare ANTHROPIC_API_KEY line here has no effect.
#  Export ANTHROPIC_API_KEY in the shell instead if you prefer the SDK's own variable.)
# The Anthropic SDK is an optional extra: pip install -e "backend[llm]". The Docker image contains it only
# when built with INCRETINOS_IMAGE_EXTRAS=llm.

# --- API exposure -----------------------------------------------------------------------------------------
# Interactive API documentation at /docs, /redoc and /openapi.json. Off by default.
# INCRETINOS_DOCS_ENABLED=true

# Browser origins allowed to call the API directly (the web app does not need this: it uses its own /api proxy).
# INCRETINOS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Request budgets for the expensive open endpoints, per client per minute, held in process memory.
# 0 disables one budget. Behind the bundled web app all users count as one client (see TRUSTED_PROXIES).
# QUERY covers the heaviest reads (validation, findings, analyses, trial adverse events, evidence review list/summary,
# evidence quality).
# INCRETINOS_RATE_LIMIT_ENABLED=true
# INCRETINOS_RATE_LIMIT_SIMULATION_PER_MINUTE=30
# INCRETINOS_RATE_LIMIT_ASSISTANT_PER_MINUTE=60
# INCRETINOS_RATE_LIMIT_QUERY_PER_MINUTE=120
# Reverse proxies (IP addresses or CIDR networks, comma-separated) whose X-Forwarded-For is believed. Empty = the
# header is ignored and the socket peer is the client. Never list the bundled web app: it forwards the header unchanged.
# INCRETINOS_RATE_LIMIT_TRUSTED_PROXIES=
# For a trusted proxy's requests only: the number of proxies that APPEND the client address (0 = the first address
# from the right that is not a trusted proxy).
# INCRETINOS_RATE_LIMIT_PROXY_HOPS=0
# Largest request body in bytes, refused with 413 before it is read: open routes (calculation routes have tighter
# limits of their own) and reviewer write routes.
# INCRETINOS_MAX_REQUEST_BODY_BYTES=65536
# INCRETINOS_MAX_REVIEW_BODY_BYTES=262144

# --- Docker Compose only ----------------------------------------------------------------------------------
# Database password. The default ("incretinos") is a published development value: set this for any deployment
# that is not a private machine. URL-safe characters only. Read when the database volume is first created.
# INCRETINOS_DB_PASSWORD=
# Host ports, and the interface each is published on. The API is published on the loopback interface only;
# the web port serves plain HTTP on all interfaces and needs a TLS proxy in front for anything shared.
# INCRETINOS_API_PORT=8000
# INCRETINOS_API_BIND=127.0.0.1
# INCRETINOS_WEB_PORT=3000
# INCRETINOS_WEB_BIND=0.0.0.0
# Optional Python extras to install into the API image (e.g. llm).
# INCRETINOS_IMAGE_EXTRAS=

# Evidence Quality: days after which a source of a type is due a refresh (overrides the defaults shown on /quality).
# INCRETINOS_QUALITY_REFRESH_DAYS=CTGOV=30,PUBMED=365
